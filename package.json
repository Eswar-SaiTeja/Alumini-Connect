{
  "name": "gcrjy-alumni-platform",
  "version": "1.0.0",
  "description": "Government College (Autonomous), Rajahmundry — Alumni Management & Connect Platform",
  "scripts": {
    "dev:server": "cd server && npm run dev",
    "dev:client": "cd client && npm run dev",
    "dev": "concurrently -n \"SERVER,CLIENT\" -c \"bgBlue.bold,bgGreen.bold\" \"npm run dev:server\" \"npm run dev:client\"",
    "build:server": "cd server && npm run build",
    "build:client": "cd client && npm run build",
    "build": "npm run build:client && npm run build:server",
    "start": "cd server && npm start",
    "db:seed": "cd server && npm run prisma:seed"
  },
  "devDependencies": {
    "concurrently": "^9.2.4"
  }
}
